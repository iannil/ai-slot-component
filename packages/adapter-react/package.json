{
  "name": "@ai-slot/adapter-react",
  "version": "0.1.0",
  "license": "MIT",
  "description": "React renderer adapter for ai-slot: render validated component trees as real React components.",
  "keywords": [
    "react",
    "ai",
    "renderer",
    "adapter"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iannil/ai-slot-component.git",
    "directory": "packages/adapter-react"
  },
  "bugs": "https://github.com/iannil/ai-slot-component/issues",
  "homepage": "https://github.com/iannil/ai-slot-component/tree/master/packages/adapter-react#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-slot/registry": "workspace:*",
    "@ai-slot/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
