{
  "name": "@ai-slot/mcp",
  "version": "0.1.3",
  "mcpName": "io.github.iannil/ai-slot-management-mcp",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ai-slot-management-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@ai-slot/operations": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iannil/ai-slot-component.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/iannil/ai-slot-component/issues"
  },
  "homepage": "https://github.com/iannil/ai-slot-component/tree/master/packages/mcp#readme",
  "description": "Experimental local stdio MCP client for the AI-SLOT management service; human approval remains separate."
}
